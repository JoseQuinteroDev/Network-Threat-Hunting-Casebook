// Analytics rule: Suricata IPS alert on the lab gateway (severity 1-2).
// Suricata writes EVE JSON to syslog (facility local5); the Azure Monitor Agent ships it to the Syslog table.
Syslog
| where Facility == "local5" and ProcessName =~ "suricata"
| extend E = parse_json(extract(@"(\{.*\})", 1, SyslogMessage))
| where tostring(E.event_type) == "alert"
| extend SrcIp = tostring(E.src_ip), DstIp = tostring(E.dest_ip), DstPort = toint(E.dest_port),
         Signature = tostring(E.alert.signature), SignatureId = tolong(E.alert.signature_id),
         Category = tostring(E.alert.category), AlertSeverity = toint(E.alert.severity)
| where AlertSeverity <= 2
| summarize Alerts = count(), FirstSeen = min(TimeGenerated), LastSeen = max(TimeGenerated)
    by SrcIp, DstIp, DstPort, Signature, SignatureId, Category
