// Analytics rule: DNS tunnel pattern in Zeek dns.log (custom table ZeekDns_CL).
// Same logic and thresholds as case 01: per client, base domain and hour, >= 50 unique subdomains,
// mean subdomain length >= 20 and mean Shannon entropy >= 3.0 bits per character.
ZeekDns_CL
| where isnotempty(query)
| extend Q = tolower(trim_end(@"\.", query))
| where not(Q endswith ".arpa" or Q endswith ".local")
| extend Labels = split(Q, ".")
| where array_length(Labels) >= 3
| extend BaseDomain = strcat(tostring(Labels[-2]), ".", tostring(Labels[-1])),
         Subdomain = strcat_array(array_slice(Labels, 0, array_length(Labels) - 3), ".")
| summarize UniqueSubdomains = dcount(Subdomain), Subdomains = make_set(Subdomain, 2000), Queries = count()
    by SrcIp = id_orig_h, BaseDomain, Hour = bin(TimeGenerated, 1h)
| where UniqueSubdomains >= 50
| mv-expand Sub = Subdomains to typeof(string)
| extend Clean = replace_string(Sub, ".", "")
| extend N = strlen(Clean), SubLen = strlen(Sub)
| mv-expand Ch = extract_all(@"(.)", Clean) to typeof(string)
| summarize K = count() by SrcIp, BaseDomain, Hour, UniqueSubdomains, Queries, Sub, SubLen, N, Ch
| summarize SubEntropy = -sum(todouble(K) / N * log2(todouble(K) / N))
    by SrcIp, BaseDomain, Hour, UniqueSubdomains, Queries, Sub, SubLen
| summarize MeanLength = round(avg(SubLen), 1), MeanEntropy = round(avg(SubEntropy), 2)
    by SrcIp, BaseDomain, Hour, UniqueSubdomains, Queries
| where MeanLength >= 20 and MeanEntropy >= 3.0
