// Analytics rule: C2 beaconing in Zeek conn.log (custom table ZeekConn_CL).
// Same score as case 02 (pair mode): mean of timing regularity, timing symmetry, size regularity and
// persistence over 24 hours; >= 20 connections and score >= 0.80. Outbound only, NTP excluded.
let window = 24h;
ZeekConn_CL
| where TimeGenerated > ago(window)
| where ipv4_is_private(id_orig_h) and not(ipv4_is_private(id_resp_h))
| where not(proto == "udp" and id_resp_p == 123)
| project TimeGenerated, Src = id_orig_h, Dst = id_resp_h, Port = id_resp_p, proto,
          Bytes = toreal(orig_ip_bytes + resp_ip_bytes)
| sort by Src asc, Dst asc, Port asc, proto asc, TimeGenerated asc
| extend Key = strcat(Src, "|", Dst, "|", Port, "|", proto)
| extend Gap = iff(prev(Key) == Key, datetime_diff("millisecond", TimeGenerated, prev(TimeGenerated)) / 1000.0, real(null))
| summarize Connections = count(), Gaps = make_list_if(Gap, isnotnull(Gap), 100000), Sizes = make_list(Bytes, 100000),
            Hours = dcount(bin(TimeGenerated, 1h)) by Src, Dst, Port, proto
| where Connections >= 20
| extend G = array_sort_asc(Gaps), S = array_sort_asc(Sizes)
| extend Q1 = todouble(G[toint(array_length(G) * 0.25)]), Med = todouble(G[toint(array_length(G) * 0.5)]),
         Q3 = todouble(G[toint(array_length(G) * 0.75)]), SizeMed = todouble(S[toint(array_length(S) * 0.5)])
| mv-apply g = Gaps to typeof(real) on (summarize GapMAD = percentile(abs(g - Med), 50))
| mv-apply b = Sizes to typeof(real) on (summarize SizeMAD = percentile(abs(b - SizeMed), 50))
| extend S_disp = max_of(0.0, 1 - GapMAD / Med),
         S_skew = iff(Q3 == Q1, 1.0, max_of(0.0, 1 - abs((Q1 + Q3 - 2 * Med) / (Q3 - Q1)))),
         S_size = iff(SizeMed > 0, max_of(0.0, 1 - SizeMAD / SizeMed), 0.0),
         S_cov = min_of(1.0, Hours / (window / 1h))
| extend Score = round((S_disp + S_skew + S_size + S_cov) / 4, 3)
| where Score >= 0.80
| project Src, Dst, Port, proto, Connections, MedianGapSeconds = round(Med, 2), S_disp, S_skew, S_size, S_cov, Score
